{
  "name": "87-freight-desktop",
  "version": "1.3.1",
  "private": true,
  "description": "87 Freight Desktop with GitHub Releases OTA",
  "author": "87 Freight LLC",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.freight87.core",
    "productName": "87 Freight Desktop",
    "artifactName": "87-Freight-Desktop-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "shell.html",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Timato87",
        "repo": "87-freight-desktop-releases",
        "releaseType": "release"
      }
    ]
  }
}
